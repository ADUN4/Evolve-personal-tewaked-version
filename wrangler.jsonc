// Cloudflare Workers configuration for this project.
//
// 形态：静态资源（dist/）+ 一个 Worker 脚本（src/worker.js）
//   Build command   : node deploy/make-dist.mjs      -> 产出 ./dist
//   Deploy command  : npx wrangler deploy            -> 读本文件，上传 dist 到 assets，并部署 worker.js
//   Preview command : npx wrangler versions upload
//
// 路由：静态资源默认优先匹配，所以没有同名文件的 /api/* 会落到 worker.js。
//
// ⚠️ 下面的 d1_databases.database_id 是占位符。
//    在 Cloudflare 后台建好 D1 数据库、把真实 ID 填进来之前不要推送 ——
//    否则线上构建会失败（旧版本会继续服务，但站点停止更新）。
{
  "name": "evolve",

  // 新增：Worker 脚本。加了它之后本项目不再是"纯静态"。
  "main": "src/worker.js",

  // Workers 要求的兼容日期，填过去的日期即可
  "compatibility_date": "2025-01-01",

  "assets": {
    // 相对本文件；deploy/make-dist.mjs 产出到这个目录
    "directory": "./dist",
    // dist/_headers 由 assets 层自动识别，静态资源的缓存/安全头照旧生效
    "not_found_handling": "none",
    // 让 worker.js 能用 env.ASSETS.fetch() 兜底服务静态文件
    "binding": "ASSETS"
  },

  // 邮箱验证码与联机账本用同一个 D1。
  // ⚠️ 表还没建之前，/api/verify/* 会返回 "no such table"（错误 JSON 里会直接提示执行 deploy/schema.sql）。
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "evolve",
      "database_id": "03624653-2c57-49c2-a1c1-c2a35a6147c9"
    }
  ],

  // 非机密配置。机密（RESEND_API_KEY 等）用 wrangler secret put，不要写在这里。
  "vars": {
    "MAIL_FROM": "noreply@mail.evolve-adun4.cn"
  }
}
